# ============================================================
# ScaleLink - Environment Variables Template
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control (it's in .gitignore).
#
# USAGE:
# cp .env.example .env
# Edit .env with your actual values
# ============================================================

# Database
DATABASE_URL=jdbc:postgresql://localhost:5432/scalelink
DATABASE_USERNAME=scalelink
DATABASE_PASSWORD=scalelink123

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=YourSuperSecretKeyHereThatIsAtLeast256BitsLong!!ChangeThisInProduction!!

# Application
BASE_URL=http://localhost:8080
SPRING_PROFILES_ACTIVE=dev
